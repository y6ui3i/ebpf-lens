[Unit]
Description=eBPFLens agent (eBPF probes)
Documentation=https://github.com/y6ui3i/ebpf-lens
After=network-online.target ebpflens-server.service
Wants=network-online.target

[Service]
# Run as a dedicated user, not root, with only the capabilities eBPF needs:
#   CAP_BPF:     create BPF programs and maps
#   CAP_PERFMON: attach to tracepoints / fentry / uprobes (as BPF links) and read kernel memory (bpf_probe_read_kernel)
# The GPU probe attaches its uprobes on libcuda as multi-uprobe BPF links (kernel 6.6+). On older kernels it falls
# back to perf_event uprobes, which Ubuntu's kernel.perf_event_paranoid=4 refuses without CAP_SYS_ADMIN
User=ebpflens
Group=ebpflens
AmbientCapabilities=CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
ExecStart=/opt/ebpflens/bin/ebpflens-agent -server http://127.0.0.1:8080
Restart=always
RestartSec=5

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
