[Unit]
Description=eBPFLens server (API, SSE, UI, SQLite)
Documentation=https://github.com/y6ui3i/ebpf-lens
After=network-online.target
Wants=network-online.target

[Service]
User=ebpflens
Group=ebpflens
# systemd creates /var/lib/ebpflens owned by the service user.
# To keep the DB elsewhere, override ExecStart and ReadWritePaths with a drop-in (see README).
StateDirectory=ebpflens
StateDirectoryMode=2775
# Files are group-writable so members of the ebpflens group can read the DB with sqlite3
# (readers of a WAL database need write access to the -shm file).
UMask=0002
ExecStart=/opt/ebpflens/bin/ebpflens-server -addr :8080 -db /var/lib/ebpflens/ebpflens.db
Restart=on-failure
RestartSec=5
# On SIGTERM the server flushes its write queue before closing the DB.
KillSignal=SIGTERM
TimeoutStopSec=15

# The server needs no privileges.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
